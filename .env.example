# Runtime API destination - Directus's native REST endpoint (/items/crm_leads),
# NOT the custom insert-only extension a sibling project (/jobs, /posts in
# ai-automation-system) posts new leads through. Same Directus host is fine;
# this is a different endpoint with a different auth scheme (plain Bearer
# token vs. a custom secret header), so it gets its own env vars rather than
# reusing CRM_LEADS_API_URL/CRM_LEADS_API_SECRET from that project.
# Copy this file to .env and fill in real values - never commit .env, and
# never hardcode any of these in a prompt/script file.
CRM_ENRICH_API_URL=
CRM_ENRICH_API_TOKEN=

# Persistent Chrome profile tools/linkedin-enrich-scrape.js launches directly
# (Playwright fully controls this profile). It starts logged out - do the
# one-time manual login described in README.md's "LinkedIn login" section,
# then every later run reuses the same signed-in session automatically.
# Defaults to D:/chrome-profiles/enrich-linkedin (its own dedicated profile,
# separate from any other project's) - override here only if you want a
# different path. A persistent context locks its profile directory, so never
# point two projects at the SAME path and run them at the same time.
# LINKEDIN_CHROME_PROFILE=D:/chrome-profiles/enrich-linkedin

# SMTP, used by scripts/Send-EnrichNotification.ps1 (invoked by the
# email-notify agent on API failure / terminal error / a fully empty run).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Comma-separated recipient lists. At least one of these plus SMTP_HOST and
# SMTP_FROM must be set for any notification to actually send.
NOTIFY_BDE_EMAILS=
NOTIFY_DEV_EMAILS=
